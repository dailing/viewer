[Unit]
Description=Viewer local workspace web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/oldroot/home/d/Sync/viewer
Environment="PATH=/mnt/oldroot/home/d/Sync/viewer/.venv/bin:/mnt/oldroot/home/d/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/mnt/oldroot/home/d/Sync/viewer/.venv/bin/python /mnt/oldroot/home/d/Sync/viewer/scripts/supervise_viewer.py -- /mnt/oldroot/home/d/Sync/viewer/.venv/bin/python /mnt/oldroot/home/d/Sync/viewer/run.py --serve-dir /mnt/oldroot/home/d/Sync --host 0.0.0.0 --port 18989
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
